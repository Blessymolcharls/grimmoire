# Database Connection URL
# For local zero-config SQLite development:
DATABASE_URL="file:./dev.db"

# For hosted PostgreSQL production (Supabase, Neon, Railway, AWS RDS, etc.):
# DATABASE_URL="postgresql://user:password@localhost:5432/hogwarts_library?schema=public"

# Application Environment
NODE_ENV="development"

# Authentication / Session Secret (for production)
NEXTAUTH_SECRET="magical_secret_replace_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Optional External Book APIs (OpenLibrary is free & unauthenticated)
# GOOGLE_BOOKS_API_KEY=""
